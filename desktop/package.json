{
  "name": "truyenco-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "node scripts/start-electron.cjs",
    "build": "vite build && cross-env NODE_ENV=production electron-builder --dir",
    "dist": "vite build && cross-env NODE_ENV=production electron-builder",
    "lint": "echo 'no lint configured'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.3",
    "axios": "^1.7.2",
    "dayjs": "^1.11.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.24.1",
    "react-hook-form": "^7.51.5",
    "yup": "^1.4.0",
    "@hookform/resolvers": "^3.3.4",
    "react-redux": "^8.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "@vitejs/plugin-react": "^4.2.1"
  },
  "build": {
    "appId": "com.truyenco.desktop",
    "productName": "TruyenCo",
    "files": [
      "dist/**",
      "app/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
